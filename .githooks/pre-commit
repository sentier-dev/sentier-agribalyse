#!/usr/bin/env bash
# ecoinvent EULA guard — refuse to commit licensed ecoinvent data.
#
# Blocks exchange amounts (Data Points), CFs attached through ecoinvent's LCIA
# implementation, ecoinvent's dataset list, built packages, the caches and
# generated outputs that carry those numbers, and any SimaPro export under
# source/ but the stripped one, even if force-staged (`git add -f`) past
# .gitignore.
# The elementary-flow snapshot is not blocked: ecoinvent publishes that master
# data under the ODbL in its Data Glossary. See BOOTSTRAP.md, section 6.
#
# Activate once per clone:  git config core.hooksPath .githooks
set -euo pipefail

# Match bytes, not characters, so a path in any encoding is tested the same way.
export LC_ALL=C

# Extended regexes, one per forbidden path class, tested against every staged
# path. Patterns have no end anchor unless they need one, so a backup or
# suffixed copy of a licensed file (`…-exchanges.parquet.bak`) is refused too:
# it holds the same data.
forbidden_patterns=(
  # Licensed snapshots (BOOTSTRAP.md sections 3 and 4).
  '^source/ecoinvent-3\.9\.1-cutoff-exchanges\.parquet'
  '^source/ecoinvent-3\.9\.1-cutoff-activities\.json'
  '^source/ef-v31-methods\.json'
  # Any SimaPro export under source/, at any depth: a file name that holds
  # ".csv" in any case, so also a compressed or renamed copy (.CSV.xz,
  # .csv.bak, .CSV~). And ADEME's full export by its own name wherever it
  # lies: AGB32_final.CSV embeds ecoinvent inventories. The one export that
  # ships is named in shipped_export below.
  '^source/(.*/)?[^/]*\.[Cc][Ss][Vv][^/]*$'
  '(^|/)[Aa][Gg][Bb]32_final\.'
  # Registry: per-method CF parquets (any slug; _index.json holds no CFs),
  # the CF comparison join (column cf_registry), and the catalogs that copy
  # the dataset list.
  '^registry/method_cfs/[^/]+/'
  '^registry/cf_comparison_join\.parquet'
  '^registry/(ecoinvent|activity)_catalog\.parquet'
  # Caches: scoring packages hold ecoinvent amounts and CFs; the linked-graph
  # pickle holds the unit processes rebuilt from the ecoinvent snapshot, and
  # both pickles hold ADEME's copied ecoinvent processes when the full export
  # was read. Nothing under cache/ is tracked.
  '^cache/'
  # Dashboard and review outputs that carry registry CFs.
  '^dashboard/cf_comparison\.csv'
  '^dashboard/decomp/'
  '^dashboard/product_reasons\.json'
  '^to_review/cf_comparison/'
  # Brightway export wherever it lands: a directory of that name at any
  # depth, and an archive of it. A file such as bw_package.py stays allowed.
  '(^|/)bw_package/'
  '(^|/)bw_package\.(zip|tar|tgz|7z|gz|xz|bz2|zst)(\.[^/]*)?$'
  # Matrix files of a scoring package or a bw_processing export, under any
  # directory name (dds-build-bw-package takes --out).
  '\.csr\.npz$'
  '(^|/)(technosphere|biosphere|characterization)\.(data|indices|flip)\.npy$'
)
forbidden="$(IFS='|'; printf '%s' "${forbidden_patterns[*]}")"

# The stripped archive written by dds-strip-ecoinvent: the only path a pattern
# above matches that is meant to be in git. The exception goes by this exact
# path, not by content: tests/integration/test_ecoinvent_free_csv_shipped.py
# checks the archive's sha256 and size against its manifest.
shipped_export='source/AGB32_ecoinvent_free.CSV.xz'

# -z prints every path verbatim, NUL-terminated: no core.quotePath quoting of
# non-ASCII names. ACMRT covers renames and copies (by their new path) and
# type changes; deletions stay allowed.
staged="$(mktemp)"
trap 'rm -f "$staged"' EXIT
git diff --cached --name-only -z --diff-filter=ACMRT >"$staged"

blocked=()
while IFS= read -r -d '' path; do
  if [[ $path == "$shipped_export" ]]; then
    continue
  fi
  if [[ $path =~ $forbidden ]]; then
    blocked+=("$path")
  fi
done <"$staged"

if [ "${#blocked[@]}" -gt 0 ]; then
  echo "✖ ecoinvent EULA guard: refusing to commit licensed ecoinvent data:" >&2
  printf '    %s\n' "${blocked[@]}" >&2
  echo >&2
  echo "These hold licensed ecoinvent amounts or CFs, caches and outputs built" >&2
  echo "from them, ecoinvent's dataset list, or a SimaPro export that may embed" >&2
  echo "ecoinvent inventories. They must stay local. Unstage them" >&2
  echo "(git restore --staged <path>) — do not force past this guard." >&2
  echo "See BOOTSTRAP.md." >&2
  exit 1
fi

exit 0
