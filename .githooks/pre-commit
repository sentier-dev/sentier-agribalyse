#!/usr/bin/env bash
# ecoinvent EULA guard — refuse to commit proprietary Licensed Data.
#
# Blocks the §3.1 paths from the EULA-clean-repo design even if they were
# force-staged (`git add -f`) past .gitignore. See BOOTSTRAP.md and
# docs/superpowers/specs/2026-06-03-ecoinvent-eula-clean-repo-design.md.
#
# Activate once per clone:  git config core.hooksPath .githooks
set -euo pipefail

# Extended-regex of forbidden staged paths. The last alternative blocks any
# uncompressed SimaPro export under source/ (ADEME's full AGB32_final.CSV
# embeds ecoinvent inventories). The only export that ships is the stripped
# archive source/AGB32_ecoinvent_free.CSV.xz, written by dds-strip-ecoinvent.
forbidden='^(source/ecoinvent-3\.9\.1-cutoff-exchanges\.parquet|source/ecoinvent-3\.9\.1-cutoff-activities\.json|source/ecoinvent-3\.9\.1-biosphere-flows\.json|source/ef-v31-methods\.json|registry/method_cfs/ecoinvent-3\.9\.1__|bw_package/|source/[^/]*\.(CSV|csv)$)'

staged="$(git diff --cached --name-only --diff-filter=AM)"

blocked="$(printf '%s\n' "$staged" | grep -E "$forbidden" || true)"

if [ -n "$blocked" ]; then
  echo "✖ ecoinvent EULA guard: refusing to commit proprietary ecoinvent data:" >&2
  printf '    %s\n' "$blocked" >&2
  echo >&2
  echo "These are licensed ecoinvent Data Points / nomenclature. They must stay" >&2
  echo "local. Unstage them (git restore --staged <path>) — do not force past" >&2
  echo "this guard. See BOOTSTRAP.md." >&2
  exit 1
fi

# The stripped archive itself: refuse it when a process block of an embedded
# ecoinvent dataset is still inside ("Copied from Ecoinvent" as it is,
# "Adapted from Ecoinvent" with a few values changed). Only the line that
# names a block's product is checked; input lines may keep the names.
archives="$(printf '%s\n' "$staged" | grep -E '^source/[^/]*\.(CSV|csv)\.xz$' || true)"
for archive in $archives; do
  if ! command -v xz >/dev/null 2>&1; then
    echo "✖ ecoinvent EULA guard: xz is needed to check $archive before committing it." >&2
    exit 1
  fi
  leftovers="$(git show ":$archive" | xz -dc | tr -d '\r' | awk '
    prev == "Products" || prev == "Waste treatment" {
      if (tolower($0) ~ /(copied|adapted) from ecoinvent[^;]*;/) n++
    }
    { prev = $0 }
    END { print n + 0 }')"
  if [ "$leftovers" != "0" ]; then
    echo "✖ ecoinvent EULA guard: $archive still holds $leftovers embedded ecoinvent" >&2
    echo "  process block(s) (Copied from / Adapted from Ecoinvent). Rebuild it with" >&2
    echo "  dds-strip-ecoinvent; do not commit it as it is." >&2
    exit 1
  fi
done

exit 0
