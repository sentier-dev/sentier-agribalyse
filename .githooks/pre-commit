#!/usr/bin/env bash
# ecoinvent EULA guard — refuse to commit licensed ecoinvent data.
#
# Blocks exchange amounts (Data Points), CFs attached through ecoinvent's LCIA
# implementation, ecoinvent's dataset list and built packages, even if
# force-staged (`git add -f`) past .gitignore. The elementary-flow snapshot is
# not blocked: ecoinvent publishes that master data under the ODbL in its Data
# Glossary. See BOOTSTRAP.md.
#
# Activate once per clone:  git config core.hooksPath .githooks
set -euo pipefail

# Extended-regex of forbidden staged paths.
forbidden='^(source/ecoinvent-3\.9\.1-cutoff-exchanges\.parquet|source/ecoinvent-3\.9\.1-cutoff-activities\.json|source/ef-v31-methods\.json|registry/method_cfs/ecoinvent-3\.9\.1__|bw_package/)'

staged="$(git diff --cached --name-only --diff-filter=AM)"

blocked="$(printf '%s\n' "$staged" | grep -E "$forbidden" || true)"

if [ -n "$blocked" ]; then
  echo "✖ ecoinvent EULA guard: refusing to commit licensed ecoinvent data:" >&2
  printf '    %s\n' "$blocked" >&2
  echo >&2
  echo "These are licensed ecoinvent amounts or CFs, or ecoinvent's dataset list." >&2
  echo "They must stay local. Unstage them (git restore --staged <path>) — do not" >&2
  echo "force past this guard. See BOOTSTRAP.md." >&2
  exit 1
fi

exit 0
