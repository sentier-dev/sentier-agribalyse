# Copy to `.env` and fill in. The real `.env` is gitignored.

# ecoinvent credentials — required only to (re-)bootstrap the gitignored
# ecoinvent-derived data from your own licence. See BOOTSTRAP.md:
#   - import ecoinvent 3.9.1 cutoff via bw2io.import_ecoinvent_release
#   - snapshot exchanges with `dds-snapshot-ecoinvent-exchanges`
#   - regenerate the activity / biosphere / EF-method JSON snapshots
# The runtime itself needs no credentials once source/ + registry/ are built.
# Get these from https://ecoquery.ecoinvent.org/ after licence purchase.
ECOINVENT_USERNAME=your-username
ECOINVENT_PASSWORD=your-password
